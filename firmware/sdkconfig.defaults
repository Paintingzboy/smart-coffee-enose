# Stack untuk main task Rust (default 3K terlalu kecil)
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# WiFi station mode
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# HTTPS/TLS — sertifikat diverifikasi dengan CA bundle bawaan ESP-IDF
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# OTA - rollback otomatis jika update firmware gagal
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_OTA_ALLOW_HTTP=y

# Tabel partisi OTA (partitions.csv) diberikan lewat espflash.toml, BUKAN di sini:
# path relatif di sdkconfig dicari di folder build CMake sehingga build gagal.
# Flash 16 MB (ESP32-S3 N16R8)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Stack task HTTP/TLS cukup besar
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
