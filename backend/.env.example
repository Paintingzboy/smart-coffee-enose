# Salin menjadi backend/.env untuk menjalankan lokal. Di Railway, isi lewat tab "Variables".
# Tanpa DATABASE_* server tetap jalan dengan penyimpanan MEMORI (hilang saat restart).

# Azure SQL
DATABASE_HOST=namaserver.database.windows.net
DATABASE_PORT=1433
DATABASE_USER=adminuser
DATABASE_PASSWORD=ganti-dengan-password-baru
DATABASE_NAME=nama-database

# Kunci — buat acak & panjang, mis. `openssl rand -hex 24`
DEVICE_API_KEY=ganti-kunci-perangkat     # hanya untuk endpoint HTTP lama (simulator); ESP32 memakai MQTT
OPERATOR_KEY=ganti-kunci-operator        # diketik di dashboard untuk mulai rekam / OTA / QC

# ThingsBoard Cloud: broker MQTT ESP32 + OTA. TB_USERNAME/TB_PASSWORD WAJIB — dipakai untuk
# membaca telemetry ESP32 (WebSocket) dan mengirim perintah (RPC). TB_API_KEY saja tidak cukup.
TB_URL=https://eu.thingsboard.cloud
TB_API_KEY=
TB_USERNAME=
TB_PASSWORD=
FW_TITLE=smart-coffee-enose

# Info model yang tampil di dashboard (isi setelah validasi GroupKFold selesai)
MODEL_NAME=Edge Impulse (belum terhubung)
MODEL_VERSION=none
# MODEL_METRIC=Macro-F1 0,81 ± 0,07
# MODEL_VALIDATION=GroupKFold k=6, grup=Coffee_ID
CONFIDENCE_THRESHOLD=0.6

# Lokal saja (Railway mengisi PORT otomatis)
PORT=3000
STATIC_DIR=../frontend/dist
